# =============================================================================
# notelm — .env (Coolify)
# =============================================================================
# Copy this into Coolify → Environment Variables and fill in the REQUIRED values.
# Generate secrets with:  openssl rand -base64 32
# =============================================================================

# ----- Upstream image version -----
SURFSENSE_VERSION=latest

# ----- App branding -----
APP_NAME=notelm
PRIMARY_COLOR=#028a39
DEFAULT_LOCALE=vi

# ----- Domains -----
NEXT_FRONTEND_URL=https://notelm.gpt4vn.com
BACKEND_URL=https://api.notelm.gpt4vn.com

# ----- Core secrets (REQUIRED) -----
SECRET_KEY=CHANGE_ME_openssl_rand_base64_32

# ----- Database (managed by the bundled `db` service) -----
DB_USER=notelm
DB_PASSWORD=CHANGE_ME_strong_password
DB_NAME=notelm

# ----- Admin account (auto-seeded on first deploy) -----
ADMIN_EMAIL=admin@notelm.local
ADMIN_PASSWORD=CHANGE_ME_strong_password_min_12_chars

# ----- Auth -----
# LOCAL = email/password (recommended).  GOOGLE = Google OAuth.
AUTH_TYPE=LOCAL
# Set FALSE to disable public sign-ups after you've created the admin.
REGISTRATION_ENABLED=FALSE

# ----- AI providers (set the ones you have) -----
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# ----- Default model routing (LiteLLM identifiers) -----
# Tip for VN users: OpenRouter + DeepSeek is a great cheap default for Vietnamese.
DEFAULT_CHAT_MODEL=openrouter/openai/gpt-4o-mini
DEFAULT_FAST_MODEL=openrouter/deepseek/deepseek-chat
DEFAULT_LONG_MODEL=openrouter/google/gemini-2.0-flash-001

# ----- Embeddings -----
# Local (default, free, runs on CPU):  sentence-transformers/all-MiniLM-L6-v2
# OpenAI:                              openai://text-embedding-3-small
# Cohere:                              cohere://embed-multilingual-v3.0
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ----- ETL (document parsing) -----
# DOCLING (local, default), UNSTRUCTURED, or LLAMACLOUD.
ETL_SERVICE=DOCLING

# ----- TTS / STT -----
TTS_SERVICE=local/kokoro
STT_SERVICE=local/base

# ----- Public API gateway (for taxlegal, testsgen, ...) -----
# Comma-separated API keys.  Generate with: openssl rand -hex 32
# Recommended: one key per consumer app, prefix for readability.
NOTELM_API_KEYS=taxlegal:CHANGE_ME_hex32,testsgen:CHANGE_ME_hex32

# ----- Logging -----
LOG_LEVEL=INFO

# ----- SearXNG -----
SEARXNG_SECRET=CHANGE_ME_openssl_rand_base64_32

# ----- Feature flags (sane defaults; uncomment to tune) -----
# SURFSENSE_ENABLE_MODEL_FALLBACK=true
# SURFSENSE_ENABLE_MODEL_CALL_LIMIT=true
# PAGES_LIMIT=2000
